---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Contacto UPNA - ${site.name}`}>
  <section class="container-ag py-8">
    <h1 class="sr-only">Contacto UPNA</h1>
  </section>
  <ContactSection source="contacto-upna" extraFields={['discount']} />
</BaseLayout>
