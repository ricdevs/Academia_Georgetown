---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Cursos subvencionados - ${site.name}`}>
  <section class="container-ag-1080 ag-content-page">
    <h1 class="ag-title">
      Formulario de Inscripción a los Cursos 100% Subvencionados por el Servicio Navarro de Empleo.
    </h1>
    <p class="ag-kicker" style="margin-top: 2rem;">Descripción Curso:</p>
    <div class="ag-grid-2" style="margin-top: 1.25rem;">
      <article class="ag-course-card">
        <h2>Nivel B2 (Inglés Empresarial)</h2>
        <ul>
          <li>Lunes a Viernes</li>
          <li>12:00-14:30</li>
          <li>Clases Presenciales u Online</li>
          <li>Del 27 de Julio al 31 de Agosto.</li>
        </ul>
      </article>
      <article class="ag-course-card">
        <h2>Nivel C1 (Inglés Empresarial)</h2>
        <ul>
          <li>Lunes a Viernes</li>
          <li>16:00-18:30</li>
          <li>Clases Presenciales u Online</li>
          <li>Del 27 de Julio al 31 de Agosto.</li>
        </ul>
      </article>
    </div>
  </section>
  <ContactSection
    source="formulario-subvencionados"
    extraFields={['course', 'dni', 'company', 'address']}
    submitLabel="Solicitar plaza"
    phone={site.phone}
  />
</BaseLayout>
