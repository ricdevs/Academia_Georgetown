---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import PecCarousel from '../components/PecCarousel.astro';
import ContactSection from '../components/ContactSection.astro';
import { pillars, site } from '../data/site';
import { pecPrograms, certCards } from '../data/catalog';

const pecItems = pecPrograms.map((p) => ({ href: `/${p.slug}/`, title: p.shortTitle }));
---

<BaseLayout title={`Inglés para Estudiantes Universitarios - ${site.name}`}>
  <section class="container-ag py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-navy">Academia de inglés en Pamplona y online</p>
    <h1 class="mt-3 text-5xl font-semibold">Inglés para universitarios</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Cursos de inglés para estudiantes universitarios y docentes con altas expectativas en mejorar su
      nivel y obtener los certificados para su desarrollo académico y profesional.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/prueba-de-nivel/">Realiza tu prueba de nivel</a>
      <a class="btn btn-secondary" href="/contacto/">Solicita más información</a>
    </div>
  </section>
  <section class="container-ag grid gap-8 py-8 md:grid-cols-2 lg:grid-cols-4">
    {pillars.map((item) => (
      <article>
        <h2 class="text-xl font-semibold text-navy">{item.title}</h2>
        <p class="mt-3 text-sm text-muted">{item.text}</p>
      </article>
    ))}
  </section>
  <section class="container-ag grid gap-6 py-12 md:grid-cols-2">
    <p class="text-muted">Prepara y certifica tu nivel de inglés con tu centro examinador en Pamplona de TOEFL iBT® y APTIS en colaboración con el British Council.</p>
    <p class="text-muted">Los cursos Georgetown te capacitan de manera eficiente y personalizada gracias a la plataforma Georgetown ALTEA y nuestro profesorado experto.</p>
    <p class="text-muted">El objetivo es prepararte en el menor tiempo posible para certificar tu nivel y destacar en tu entorno académico.</p>
    <p class="text-muted">Aumenta tus opciones de éxito; multiplica las oportunidades de estudiar o trabajar en el extranjero.</p>
  </section>
  <section class="container-ag grid gap-4 py-8 sm:grid-cols-2 lg:grid-cols-3">
    {certCards.map((item) => (
      <a href={item.href} class="rounded-md bg-navy p-8 text-center text-white no-underline">
        <h3 class="text-xl font-semibold">{item.title}</h3>
      </a>
    ))}
  </section>
  <PecCarousel items={pecItems} />
  <FaqAccordion />
  <ContactSection source="universitarios" />
</BaseLayout>
