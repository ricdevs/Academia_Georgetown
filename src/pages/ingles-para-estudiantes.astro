---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CardCarousel from '../components/CardCarousel.astro';
import ContactSection from '../components/ContactSection.astro';
import SplitHero from '../components/SplitHero.astro';
import { pillars, site } from '../data/site';
import { pecPrograms } from '../data/catalog';
import { certCardMedia, pecImage } from '../data/media';

const pecItems = pecPrograms.map((p, i) => ({
  href: `/${p.slug}/`,
  title: p.shortTitle,
  image: pecImage(i),
}));
---

<BaseLayout title={`Inglés para Estudiantes Universitarios - ${site.name}`}>
  <SplitHero
    kicker="Academia de inglés en Pamplona y online"
    titleLines={['Inglés para', 'Universitarios']}
    lede="Cursos de inglés para estudiantes universitarios y docentes con altas expectativas en mejorar su nivel de inglés y obtener los certificados deseados para su desarrollo tanto académico como profesional."
    image="/images/hero-academico.jpg"
    imageAlt="Gafas sobre un cuaderno abierto junto a un ordenador portátil"
    primary={{ href: '/prueba-de-nivel/', label: 'Realiza tu prueba de nivel' }}
    secondary={{ href: '/contacto/', label: 'Solicita más información' }}
  />
  <section class="ag-section-tight">
    <div class="container-ag">
      <div class="ag-grid-4">
        {pillars.map((item) => (
          <article class="ag-blurb" data-reveal>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="ag-section-tight">
    <div class="container-ag">
      <div class="ag-grid-2">
        <p class="ag-body">Prepara y certifica tu nivel de inglés con tu centro examinador en Pamplona de TOEFL iBT® y APTIS en colaboración con el British Council.</p>
        <p class="ag-body">Los cursos Georgetown te capacitan de manera eficiente y personalizada gracias a la plataforma Georgetown ALTEA y nuestro profesorado experto.</p>
        <p class="ag-body">El objetivo es prepararte en el menor tiempo posible para certificar tu nivel y destacar en tu entorno académico.</p>
        <p class="ag-body">Aumenta tus opciones de éxito; multiplica las oportunidades de estudiar o trabajar en el extranjero.</p>
      </div>
    </div>
  </section>
  <CardCarousel title="Certificados de Inglés Más Demandados" items={[...certCardMedia]} show={3} />
  <CardCarousel title="Programas Georgetown PEC – Inglés Específico" items={pecItems} show={4} scroll={4} gap={18} />
  <FaqAccordion />
  <ContactSection source="universitarios" />
</BaseLayout>
