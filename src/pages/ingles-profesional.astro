---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CardCarousel from '../components/CardCarousel.astro';
import ContactSection from '../components/ContactSection.astro';
import PageHero from '../components/PageHero.astro';
import { pillars, site } from '../data/site';
import { pecPrograms } from '../data/catalog';
import { certCardMedia, pecImage } from '../data/media';

const pecItems = pecPrograms.map((p, i) => ({
  href: `/${p.slug}/`,
  title: p.shortTitle,
  image: pecImage(i),
}));
---

<BaseLayout title={`Cursos de Inglés para el sector profesional - ${site.name}`}>
  <PageHero
    title="Inglés profesional"
    lede="Cursos de inglés para cada etapa de tu carrera profesional. Demuestra tu competencia en entrevistas, domina el vocabulario y los conceptos clave que te abrirán las puertas del puesto que quieres."
  />
  <section class="ag-section-tight">
    <div class="container-ag">
      <div class="ag-grid-4">
        {pillars.map((item) => (
          <article class="ag-blurb" data-reveal>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <CardCarousel title="Certificados más demandados" items={[...certCardMedia]} show={3} />
  <CardCarousel title="Programas Georgetown PEC – Inglés Específico" items={pecItems} show={4} scroll={4} gap={18} />
  <FaqAccordion />
  <ContactSection source="profesional" phone={site.phoneAlt} />
</BaseLayout>
