---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import intro from '../../data/blog-intro.json';
import { site } from '../../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`Blog Georgetown - ${site.name}`} description="Artículos sobre inglés, internacionalización y empleabilidad.">
  <section class="container-ag max-w-3xl py-16">
    <p class="ag-kicker" style="color: var(--color-navy);">Misión y visión</p>
    <h1 class="ag-title">{intro.title}</h1>
    <div class="prose-ag mt-8">
      {intro.body.split('\n\n').map((p) => <p>{p}</p>)}
    </div>
  </section>
  <section class="container-ag grid gap-8 pb-16 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => (
      <a href={`/blog/${post.id}/`} class="block border border-line p-6 no-underline hover:border-navy">
        <h2 class="text-xl font-semibold text-navy">{post.data.title}</h2>
        <p class="mt-2 text-sm text-muted">{post.data.description}</p>
      </a>
    ))}
  </section>
</BaseLayout>
