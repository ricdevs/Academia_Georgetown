---
import BaseLayout from '../layouts/BaseLayout.astro';
import legal from '../data/legal.json';
import { site } from '../data/site';
---

<BaseLayout title={`Términos y Condiciones - ${site.name}`}>
  <article class="prose-ag container-ag-1080 ag-content-page">
    {legal.terminos.map((line, i) => (i === 0 ? <h1>{line}</h1> : <p>{line}</p>))}
  </article>
</BaseLayout>
