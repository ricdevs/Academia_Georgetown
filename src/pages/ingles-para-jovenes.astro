---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CardCarousel from '../components/CardCarousel.astro';
import ContactSection from '../components/ContactSection.astro';
import PageHero from '../components/PageHero.astro';
import { pillars, site } from '../data/site';
import { youthCertCards } from '../data/catalog';

const youthImages: Record<string, string> = {
  '/a2-ket/': '/images/certs/b2-first.jpg',
  '/b1-preliminary/': '/images/certs/c1-advanced.jpg',
  '/b2-first-certificate/': '/images/certs/b2-first.jpg',
  '/c1-advanced/': '/images/certs/c1-advanced.jpg',
};
---

<BaseLayout title={`Cursos de Inglés para Jóvenes - ${site.name}`}>
  <PageHero
    title="Inglés para escolares"
    lede="Cursos de inglés y certificados para multiplicar las opciones académicas y forjar un futuro profesional."
  />
  <section class="ag-section-tight">
    <div class="container-ag">
      <div class="ag-grid-3">
        <article class="ag-blurb" data-reveal>
          <h2>Método de enseñanza líder</h2>
          <p>Si tus objetivos son aprender y mejorar el inglés de una manera rápida y eficaz, en Georgetown descubrirás el método para conseguirlo.</p>
        </article>
        <article class="ag-blurb" data-reveal>
          <h2>Cursos adaptados</h2>
          <p>El contenido específico de nuestros cursos permite controlar el progreso, optimizar recursos y aprovechar el tiempo al máximo.</p>
        </article>
        <article class="ag-blurb" data-reveal>
          <h2>Plataforma para el dominio del inglés</h2>
          <p>Gracias al método Georgetown y el profesorado experto, los alumnos consiguen éxito académico y profesional.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="ag-section-tight">
    <div class="container-ag">
      <div class="ag-grid-4">
        {pillars.map((item) => (
          <article class="ag-blurb">
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <CardCarousel
    title="Certificados más demandados"
    items={youthCertCards.map((item) => ({
      ...item,
      image: youthImages[item.href] ?? '/images/certs/b2-first.jpg',
    }))}
    show={4}
  />
  <FaqAccordion />
  <ContactSection source="jovenes" phone={site.phoneAlt} />
</BaseLayout>
