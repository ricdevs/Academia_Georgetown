---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Página no encontrada - ${site.name}`}>
  <section class="container-ag-1080 ag-content-page" style="text-align: center;">
    <h1 class="ag-title">Página no encontrada</h1>
    <p class="ag-body" style="margin-top: 1rem;">La dirección no existe o se ha trasladado.</p>
    <a class="btn btn-primary" href="/" style="margin-top: 2rem;">Volver al inicio</a>
  </section>
</BaseLayout>
