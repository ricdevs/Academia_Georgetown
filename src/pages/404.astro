---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Página no encontrada - ${site.name}`}>
  <section class="container-ag py-24 text-center">
    <h1 class="ag-title">Página no encontrada</h1>
    <p class="mt-4 text-muted">La dirección no existe o se ha trasladado.</p>
    <a class="btn btn-on-light mt-8" href="/">Volver al inicio</a>
  </section>
</BaseLayout>
