---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplitHero from '../components/SplitHero.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CardCarousel from '../components/CardCarousel.astro';
import ContactSection from '../components/ContactSection.astro';
import { mission, pillars, site } from '../data/site';
import { pecPrograms } from '../data/catalog';
import ExamLogos from '../components/ExamLogos.astro';
import { certCardMedia, missionIcons, pecImage } from '../data/media';
import { withBase } from '../lib/url';

const pecItems = pecPrograms.map((p, i) => ({
  href: `/${p.slug}/`,
  title: p.shortTitle,
  image: pecImage(i),
}));
---

<BaseLayout title={`${site.name} - Academia de Inglés en Pamplona`}>
  <SplitHero
    kicker="Academia de inglés en Pamplona y online"
    titleLines={['Academia', 'Georgetown']}
    lede="Tu Centro Preparador y Examinador de Certificados de Inglés en Pamplona: Certificados Cambridge, TOEFL iBT®, APTIS by British Council, IELTS y Georgetown PEC."
    image="/images/hero-home.jpg"
    imageAlt="Estudiantes colaborando alrededor de un portátil"
    imageShape="soft"
    primary={{ href: '/prueba-de-nivel/', label: 'Realiza una prueba de nivel' }}
    secondary={{ href: '/contacto/', label: 'Solicita más información' }}
  />

  <section class="ag-section ag-center ag-excelencia" data-reveal>
    <div class="container-ag-1080">
      <h2 class="ag-title">Excelencia Académica</h2>
      <p class="ag-body narrow">
        El método de la Academia de Inglés Georgetown ha sido desarrollado por un grupo de expertos
        lingüistas con el objetivo de ofrecer el programa más completo y que mejor se ajuste a tus
        necesidades de enseñanza del inglés. Nuestro profesorado y método ofrecen un programa que
        permite a los alumnos desarrollar su dominio del inglés ahorrando tiempo y esfuerzo. Gracias
        a la plataforma Georgetown ALTEA (Acquisition Learning Technologies &amp; Electronic
        Assessment), en colaboración con la Academia de Inglés Georgetown, y la atención
        personalizada del profesorado, conseguirás los resultados que deseas para cumplir tus
        objetivos.
      </p>
    </div>
  </section>

  <section class="ag-afterwave">
    <div class="container-ag-1080">
      <h2>Academia de Inglés Georgetown</h2>
    </div>
  </section>

  <section class="ag-section-tight">
    <div class="container-ag-1080">
      <h2 class="ag-subtitle" style="font-size: 22px; color: #444;">
        Los Cursos de Academia de Inglés Georgetown permiten Aprender en el mínimo tiempo. Con
        nuestras soluciones Avanzadas para la Capacitación en Inglés que se adaptan a cada alumno.
      </h2>
      <div class="ag-grid-4">
        {pillars.map((item) => (
          <article class="ag-blurb">
            <h4>{item.title}</h4>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ag-section-tight" data-reveal>
    <div class="container-ag-1080">
      <h2 class="ag-title ag-center">Misión de la Academia de Inglés Georgetown</h2>
      <div class="ag-grid-3" style="margin-top: 2rem;">
        {mission.slice(0, 3).map((item, i) => (
          <article class="ag-blurb icon-sm">
            <img src={withBase(missionIcons[i])} alt="" width="54" height="70" />
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ag-section-tight" data-reveal>
    <div class="container-ag-1080">
      <div class="ag-grid-3">
        {mission.slice(3).map((item, i) => (
          <article class="ag-blurb icon-md">
            <img src={withBase(missionIcons[i + 3])} alt="" width="93" height="70" />
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ExamLogos />

  <div data-reveal="fade">
    <CardCarousel title="Certificados de Inglés Más Demandados" items={[...certCardMedia]} show={3} scroll={1} />
  </div>

  <section class="ag-section-tight">
    <div class="container-ag-1080">
      <blockquote class="ag-quote">
        <p>
          Desde el primer día me di cuenta de lo positivo y enriquecedor que iba a ser el curso para
          la vida profesional. En primer lugar lo enfocado que está en lo importante: vocabulario y
          conversación (temas clave para el día a día). Durante todo el curso se enfatiza el aprender
          vocabulario técnico y ponerlo en práctica en ejercicios de conversación. Por otro lado los
          ejercicios se basan en situaciones reales: entrevistas, presentación de proyectos… Todo
          ello a través de una plataforma que hace todo más fácil y que hace que tengas más ganas de
          seguir haciendo ejercicios. Muy recomendable hacer el curso para mejorar y perfeccionar el
          inglés del sector del automóvil.
        </p>
        <footer>
          <cite>Adrián Manías Silva</cite>
          <div class="ag-role">Ciencias Económicas, UPNA</div>
        </footer>
      </blockquote>
    </div>
  </section>

  <div data-reveal="fade">
    <CardCarousel
      title="Programas Georgetown PEC – Inglés Específico"
      items={pecItems}
      show={4}
      scroll={4}
      gap={18}
      autoplay={6000}
    />
  </div>

  <FaqAccordion />
  <ContactSection source="home" phone={site.phone} fieldOrder="home" />
</BaseLayout>
