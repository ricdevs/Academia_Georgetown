---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import {
  pecPrograms,
  pecBySlug,
  certificates,
  extractedPages,
  landingBySlug,
  seoLandings,
} from '../data/catalog';
import { site } from '../data/site';
import { seoBodies } from '../data/landings';
import { withBase } from '../lib/url';
import certificatePages from '../data/certificate-pages.json';
import CertificatePage from '../components/CertificatePage.astro';

export function getStaticPaths() {
  const pec = pecPrograms.map((p) => ({ params: { slug: p.slug }, props: { kind: 'pec' as const } }));
  const certs = certificates.map((slug) => ({ params: { slug }, props: { kind: 'cert' as const } }));
  const landings = seoLandings.map((l) => ({
    params: { slug: l.slug },
    props: { kind: 'landing' as const },
  }));
  return [...pec, ...certs, ...landings];
}

const { slug } = Astro.params;
const { kind } = Astro.props;

const pec = kind === 'pec' ? pecBySlug[slug!] : undefined;
const certLines = kind === 'cert' ? (extractedPages as Record<string, string[]>)[slug!] ?? [] : [];
const landing = kind === 'landing' ? landingBySlug[slug!] : undefined;
const seo = slug ? seoBodies[slug] : undefined;

const certificate = kind === 'cert' ? certificatePages[slug as keyof typeof certificatePages] : undefined;
const title = pec?.title ?? certLines[0] ?? landing?.title ?? site.name;
const description = certificate?.description || pec?.description || site.description;
const documentTitle = certificate?.documentTitle ?? `${title} - ${site.name}`;

function classifyCert(lines: string[]) {
  const heading = lines[0] ?? '';
  const express = lines[1] ?? '';
  const body: { type: 'h2' | 'p' | 'quote' | 'cite'; text: string }[] = [];
  const rest = lines.slice(2);
  rest.forEach((line, i) => {
    if (line.startsWith('¿') && line.endsWith('?')) body.push({ type: 'h2', text: line });
    else if (i === rest.length - 1 && line.length < 90 && !line.endsWith('.')) body.push({ type: 'cite', text: line });
    else if (i === rest.length - 2 && rest[rest.length - 1].length < 90 && line.length > 80)
      body.push({ type: 'quote', text: line });
    else body.push({ type: 'p', text: line });
  });
  return { heading, express, body };
}

const cert = kind === 'cert' ? classifyCert(certLines) : null;
---

<BaseLayout
  title={documentTitle}
  description={description}
  course={
    certificate
      ? { name: certificate.title, description: certificate.description }
      : kind === 'cert'
        ? { name: String(title), description }
        : undefined
  }
>
  {pec && (
    <article class="container-ag-1080 ag-pec">
      <p class="ag-kicker">{pec.area}</p>
      <h1 data-reveal="left">{pec.headline}</h1>
      <p class="ag-lede">{pec.subtitle}</p>
      <div class="ag-hero-actions">
        <a class="btn btn-primary" href={withBase('/contacto/')}>Solicitar Información</a>
        <a class="btn btn-muted" href={withBase('/contenido/')}>Contenido</a>
        <a class="btn btn-muted" href={withBase('/matricula-y-financiacion/')}>Matrícula Y Financiación</a>
      </div>
      <h2 class="ag-pec-allow">Completar con éxito el presente curso y obtener el certificado le permitirá:</h2>
      <ul class="ag-pec-benefits">
        {pec.benefits.map((b) => <li>{b}</li>)}
      </ul>
      <div class="mt-10 ag-grid-3">
        <div class="ag-blurb">
          <h3>Idóneo para</h3>
          <p>{pec.idealFor}</p>
        </div>
        <div class="ag-blurb">
          <h3>Horario</h3>
          <p>{pec.schedule}</p>
        </div>
        <div class="ag-blurb">
          <h3>Modalidad</h3>
          <p>{pec.modality}</p>
        </div>
      </div>
      <h2 class="ag-title" style="margin-top: 3rem; font-size: 1.6rem;">Materias Incluidas</h2>
      <p class="ag-body">
        Nuestro programa de inglés técnico – {pec.area} cubre todas las áreas o especialidades
        sobre las que el examen te pueda presentar preguntas.
      </p>
      <ul class="ag-pec-subjects">
        {pec.subjects.map((s) => <li>{s}</li>)}
      </ul>
    </article>
  )}

  {certificate && <CertificatePage slug={slug!} {...certificate} />}

  {cert && !certificate && (
    <article class="prose-ag container-ag-1080 ag-content-page">
      <p class="ag-kicker">{cert.heading}</p>
      <h1>{cert.express}</h1>
      {cert.body.map((block) =>
        block.type === 'h2' ? (
          <h2>{block.text}</h2>
        ) : block.type === 'quote' ? (
          <blockquote class="ag-quote">
            <p>{block.text}</p>
          </blockquote>
        ) : block.type === 'cite' ? (
          <p class="ag-cert-cite">{block.text}</p>
        ) : (
          <p>{block.text}</p>
        ),
      )}
      <p>
        <a class="btn btn-primary mt-6 inline-flex" href={withBase('/prueba-de-nivel/')}>Realiza una prueba de nivel</a>
      </p>
    </article>
  )}

  {landing && (
    <article class="prose-ag container-ag-1080 ag-content-page">
      <h1>{landing.h1}</h1>
      <p>{seo?.intro}</p>
      <p>A continuación, puedes ver un listado de servicios que podemos ofrecerte para mejorar tu nivel de inglés:</p>
      <ul>
        {(seo?.links ?? []).map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
      <p>
        Si estás interesado, contacta a través del formulario o llama al {site.phone}.
      </p>
    </article>
  )}

  {!certificate && <ContactSection source={slug} phone={site.phone} />}
</BaseLayout>
