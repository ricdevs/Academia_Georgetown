---
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  items: { href: string; title: string }[];
}

const { title = 'Programas Georgetown PEC – Inglés Específico', items } = Astro.props;
---

<section class="container-ag py-16">
  <h2 class="mb-8 text-center text-3xl font-light">{title}</h2>
  <div class="relative">
    <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory" data-carousel>
      {items.map((item) => (
        <a
          href={withBase(item.href)}
          class="snap-start min-w-[240px] rounded-md bg-navy p-6 text-white no-underline shadow-lg"
        >
          <h3 class="text-lg font-semibold leading-snug">{item.title}</h3>
        </a>
      ))}
    </div>
  </div>
</section>
