---
interface Props {
  kicker?: string;
  titleLines: string[];
  subLines?: string[];
  lede?: string;
  image: string;
  imageAlt?: string;
  imageShape?: 'stadium' | 'soft';
  tall?: boolean;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}

const {
  kicker = 'Academia de inglés en Pamplona y online',
  titleLines,
  subLines = [],
  lede,
  image,
  imageAlt = '',
  imageShape = 'stadium',
  tall = false,
  primary = { href: '/prueba-de-nivel/', label: 'Realiza una prueba de nivel' },
  secondary = { href: '/contacto/', label: 'Solicita más información' },
} = Astro.props;
---

<section class="ag-split">
  <div class="container-ag-1080 ag-split-inner">
    <div class="ag-split-copy" data-reveal="left">
      {kicker && (
        <p class="ag-kicker-line">
          <span class="ag-kicker-rule"></span>
          {kicker}
        </p>
      )}
      <h1>
        {titleLines.map((line) => (
          <span>{line}</span>
        ))}
      </h1>
      {subLines.length > 0 && (
        <div class="ag-hero-sub">
          {subLines.map((line) => (
            <h3>{line}</h3>
          ))}
        </div>
      )}
      {lede && <p class="ag-lede">{lede}</p>}
      <div class="ag-hero-actions">
        {primary && (
          <a class="btn btn-primary" href={primary.href}>
            {primary.label}
          </a>
        )}
        {secondary && (
          <a class="btn btn-muted" href={secondary.href}>
            {secondary.label}
          </a>
        )}
      </div>
    </div>
    <div class:list={['ag-split-media', imageShape === 'soft' && 'is-soft', tall && 'is-tall']}>
      <div class="ag-split-media-wrap">
        <img src={image} alt={imageAlt} width="1707" height="2560" />
      </div>
    </div>
  </div>
  <div class="ag-wave" aria-hidden="true"></div>
</section>
