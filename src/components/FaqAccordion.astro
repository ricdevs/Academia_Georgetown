---
import { faqs as defaultFaqs } from '../data/site';

interface Props {
  items?: { q: string; a: string }[];
}

const { items = defaultFaqs } = Astro.props;
---

<section class="container-ag py-16">
  <h2 class="mb-8 text-center text-3xl font-light">Preguntas Frecuentes</h2>
  <div class="mx-auto max-w-3xl divide-y divide-line border-y border-line">
    {items.map((item) => (
      <details class="group py-4">
        <summary class="cursor-pointer list-none text-lg font-semibold text-navy">
          {item.q}
        </summary>
        <p class="mt-3 text-muted leading-relaxed">{item.a}</p>
      </details>
    ))}
  </div>
</section>
