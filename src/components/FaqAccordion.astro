---
import { faqs as defaultFaqs } from '../data/site';

interface Props {
  items?: { q: string; a: string }[];
}

const { items = defaultFaqs } = Astro.props;
---

<section class="ag-section">
  <div class="container-ag">
    <h2 class="ag-title ag-center" style="margin-bottom: 1.5rem;">Preguntas Frecuentes</h2>
    <div class="mx-auto max-w-3xl">
      {items.map((item) => (
        <div class="ag-toggle" data-toggle>
          <button class="ag-toggle-title" type="button" aria-expanded="false">
            <span>{item.q}</span>
            <span class="ag-toggle-icon" aria-hidden="true"></span>
          </button>
          <div class="ag-toggle-panel">
            <p>{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
