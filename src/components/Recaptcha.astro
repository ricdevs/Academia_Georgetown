---
import { site } from '../data/site';
import { isPagesPreview } from '../lib/url';

/** Production key is bound to academiageorgetown.com — skip it on GitHub Pages. */
const enabled = !isPagesPreview();
const src = `https://www.google.com/recaptcha/api.js?render=${site.recaptchaSiteKey}`;
---

{enabled && <script is:inline src={src}></script>}
