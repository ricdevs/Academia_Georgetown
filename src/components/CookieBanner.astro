---
import { site } from '../data/site';
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-line bg-white p-5 shadow-[0_-8px_30px_rgb(0_0_0_/_0.08)]"
>
  <div class="container-ag flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p class="max-w-3xl text-sm text-muted">
      Esta web utiliza cookies para ofrecerte la mejor experiencia de usuario. Puedes aceptar las
      cookies analíticas y de marketing o limitarlas a las estrictamente necesarias.
      Más información en la <a href="/politica-privacidad/">política de privacidad</a>.
    </p>
    <div class="flex flex-wrap gap-3">
      <button type="button" id="cookie-necessary" class="btn btn-secondary">Solo necesarias</button>
      <button type="button" id="cookie-all" class="btn btn-primary">Aceptar</button>
    </div>
  </div>
</div>
<script define:vars={{ gtmNote: site.gtmId }}>
  const KEY = 'ag-cookies';
  const banner = document.getElementById('cookie-banner');
  const saved = localStorage.getItem(KEY);
  if (!saved) banner?.classList.remove('hidden');
  document.getElementById('cookie-necessary')?.addEventListener('click', () => {
    localStorage.setItem(KEY, 'necessary');
    banner?.classList.add('hidden');
  });
  document.getElementById('cookie-all')?.addEventListener('click', () => {
    localStorage.setItem(KEY, 'all');
    banner?.classList.add('hidden');
    window.loadMarketing?.();
  });
  void gtmNote;
</script>
