---
import Recaptcha from './Recaptcha.astro';
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';

interface Props {
  source?: string;
  phone?: string;
  extraFields?: Array<'discount' | 'dni' | 'address' | 'company' | 'course'>;
  submitLabel?: string;
  heading?: boolean;
}

const { heading = false, phone = site.phoneAlt, ...formProps } = Astro.props;
---

{heading && (
  <section class="ag-section-tight">
    <div class="container-ag">
      <h2 class="ag-title">Formulario de contacto</h2>
    </div>
  </section>
)}
<section class="ag-contact" id="contacto" style="background-image: url('/images/contact-bg.jpg')">
  <div class="container-ag ag-contact-inner">
    <div class="ag-contact-copy" data-reveal>
      <h2>Descubre cómo la Academia Georgetown puede ayudarte a conseguir tus objetivos.</h2>
      <p>
        Uno de nuestros expertos se pondrá en contacto contigo para identificar tus necesidades o
        solucionar cualquier duda a través de la dirección y teléfono que nos facilites en el
        siguiente formulario.
      </p>
      <p class="ag-phone">Teléfono: {phone}</p>
    </div>
    <div data-reveal>
      <ContactForm {...formProps} />
    </div>
  </div>
  <Recaptcha />
</section>
