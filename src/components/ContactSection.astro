---
import Recaptcha from './Recaptcha.astro';
import ContactWizard from './ContactWizard.astro';
import { site } from '../data/site';

interface Props {
  source?: string;
  phone?: string;
  extraFields?: Array<'discount' | 'dni' | 'address' | 'company' | 'course'>;
  submitLabel?: string;
  heading?: boolean;
  fieldOrder?: 'default' | 'home';
  copyHeading?: string;
  titleTag?: 'h1' | 'h2';
}

const {
  heading: _heading,
  copyHeading: _copyHeading,
  phone = site.phone,
  titleTag = 'h2',
  ...formProps
} = Astro.props;
---

<ContactWizard {...formProps} phone={phone} titleTag={titleTag} />
<Recaptcha />
