---
import Recaptcha from './Recaptcha.astro';
import ContactForm from './ContactForm.astro';

interface Props {
  source?: string;
  phone?: string;
  extraFields?: Array<'discount' | 'dni' | 'address' | 'company' | 'course'>;
  submitLabel?: string;
  heading?: boolean;
}
const { heading = true, ...props } = Astro.props;
---

{heading && (
  <section class="ag-section-tight">
    <div class="container-ag">
      <h2 class="ag-title">Formulario de contacto</h2>
    </div>
  </section>
)}
<section class="ag-contact" style="background-image: url('/images/contact-bg.jpg')">
  <div class="container-ag ag-contact-inner">
    <ContactForm theme="dark" {...props} />
  </div>
  <Recaptcha />
</section>
