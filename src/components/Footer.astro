---
import { footerLinks, site } from '../data/site';
---

<footer class="mt-16 border-t border-line bg-white">
  <div class="container-ag grid gap-10 py-14 md:grid-cols-2">
    <div>
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-navy">Enlaces</p>
      <ul class="space-y-2">
        {footerLinks.enlaces.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-muted no-underline hover:text-navy"
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-navy">Contactar</p>
      <ul class="space-y-2">
        {footerLinks.contactar.map((item) => (
          <li>
            <a href={item.href} class="text-muted no-underline hover:text-navy">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-line py-6 text-center text-sm text-muted">
    Copyright © {new Date().getFullYear()} {site.legalName} | All Rights Reserved
  </div>
</footer>
