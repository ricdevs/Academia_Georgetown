---
import { nav, site } from '../data/site';
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-white/95 backdrop-blur">
  <div class="container-ag flex items-center justify-between gap-6 py-3">
    <a href="/" class="flex items-center gap-3 no-underline" aria-label={site.name}>
      <img src="/images/logo.png" alt="" class="h-10 w-auto" width="200" height="33" />
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-[13px] font-semibold tracking-wide text-navy no-underline hover:opacity-70"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <button
      id="menu-btn"
      class="md:hidden text-navy text-sm font-semibold"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      Menú
    </button>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-line px-6 py-4 md:hidden" aria-label="Móvil">
    <div class="flex flex-col gap-3">
      {nav.map((item) => (
        <a href={item.href} class="text-navy font-semibold no-underline">{item.label}</a>
      ))}
    </div>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const navEl = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = !navEl?.classList.contains('hidden');
    navEl?.classList.toggle('hidden', open);
    btn.setAttribute('aria-expanded', String(!open));
  });
</script>
