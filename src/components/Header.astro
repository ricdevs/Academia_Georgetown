---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
---

<header class="ag-header">
  <div class="container-ag ag-header-inner">
    <a href="/" class="ag-logo" aria-label={site.name}>
      <img src="/images/logo.png" alt={site.name} width="457" height="75" />
    </a>
    <nav aria-label="Principal">
      <ul class="ag-nav">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class={path === item.href ? 'is-current' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button
      id="menu-btn"
      class="ag-menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Abrir menú"
    >
      <span></span>
    </button>
  </div>
  <nav id="mobile-nav" class="container-ag ag-mobile-nav" aria-label="Móvil">
    {nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
</header>
