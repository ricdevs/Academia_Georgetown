---
import { site } from '../data/site';

interface Props {
  source?: string;
  extraFields?: Array<'discount' | 'dni' | 'address' | 'company' | 'course'>;
  submitLabel?: string;
  fieldOrder?: 'default' | 'home';
  phone?: string;
  titleTag?: 'h1' | 'h2';
}

const {
  source = 'contacto',
  extraFields = [],
  submitLabel = 'Enviar',
  fieldOrder = 'default',
  phone = site.phone,
  titleTag = 'h2',
} = Astro.props;

const homeOrder = fieldOrder === 'home';
const funded = extraFields.includes('course');
const whatsappHref = `https://wa.me/34${site.phoneAlt.replace(/\s/g, '')}`;
const phoneHref = phone.replace(/\s/g, '').startsWith('+') ? `tel:${phone.replace(/\s/g, '')}` : `tel:+34${phone.replace(/\s/g, '')}`;

const goals = [
  {
    value: 'Cambridge',
    title: 'Cambridge',
    text: 'First, Advanced o Proficiency con centro examinador oficial.',
  },
  {
    value: 'Aptis',
    title: 'Aptis',
    text: 'Aptis General o Advanced by British Council.',
  },
  {
    value: 'TOEFL',
    title: 'TOEFL',
    text: 'TOEFL iBT® para universidad y movilidad internacional.',
  },
  {
    value: 'Empresa y Negociación',
    title: 'Empresa y Negociación',
    text: 'Fluidez ejecutiva, presentaciones e entrevistas.',
  },
  {
    value: 'Escolares',
    title: 'Escolares',
    text: 'ESO, Bachillerato y refuerzo para jóvenes.',
  },
  {
    value: 'Otro',
    title: 'Otro',
    text: 'Cuéntanos tu objetivo y te preparamos un itinerario.',
  },
];

const levels = [
  { value: 'Básico', title: 'Básico' },
  { value: 'Intermedio', title: 'Intermedio' },
  { value: 'Avanzado', title: 'Avanzado' },
];

const reasons = [
  {
    title: '98.4% de Aprobado en 1ª Convocatoria',
    text: 'Metodología auditada al 100% en el marco oficial Cambridge y Aptis.',
  },
  {
    title: 'Grupos Ultra-Reducidos',
    text: 'Máximo 8 alumnos por aula para garantizar 20-30 minutos de speaking por sesión.',
  },
  {
    title: 'Nativos Titulados y Examinadores',
    text: 'Docentes con certificación DELTA/CELTA y amplia experiencia en tribunales oficiales.',
  },
];
---

<section class="ag-lead" id="contacto" data-wizard>
  <div class="ag-lead-wrap">
    <header class="ag-lead-intro">
      {titleTag === 'h1' ? (
        <h1 class="ag-lead-title">Ponte en contacto con nosotros y te diseñaremos un itinerario personalizado</h1>
      ) : (
        <h2 class="ag-lead-title">Ponte en contacto con nosotros y te diseñaremos un itinerario personalizado</h2>
      )}
    </header>

    <div class="ag-lead-grid">
      <div class="ag-lead-main">
        <form class="ag-lead-form js-lead-form" data-source={source}>
          <input type="hidden" name="source" value={source} />
          <input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" />

          <div class="ag-lead-step" data-step="1">
            <div class="ag-lead-step-head">
              <p class="ag-lead-kicker">Paso 1 de 2</p>
              <p class="ag-lead-badge">Evaluación confidencial</p>
            </div>
            <h3 class="ag-lead-step-title">Define tu objetivo principal</h3>
            <ol class="ag-lead-progress" aria-label="Progreso del formulario">
              <li class="is-on"><span>1</span> Objetivo</li>
              <li><span>2</span> Tus datos</li>
            </ol>

            <fieldset class="ag-lead-fieldset">
              <legend>¿Para qué necesitas acreditar o perfeccionar tu inglés? *</legend>
              <div class="ag-lead-goals">
                {goals.map((goal) => (
                  <label class="ag-lead-goal">
                    <input type="radio" name="englishGoal" value={goal.value} required />
                    <span class="ag-lead-goal-copy">
                      <strong>{goal.title}</strong>
                      <em>{goal.text}</em>
                    </span>
                    <span class="ag-lead-radio" aria-hidden="true"></span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="ag-lead-fieldset">
              <legend>¿Cuál consideras que es tu nivel de partida aproximado? *</legend>
              <div class="ag-lead-levels">
                {levels.map((level) => (
                  <label class="ag-lead-level">
                    <input type="radio" name="startingLevel" value={level.value} required />
                    <strong>{level.title}</strong>
                  </label>
                ))}
              </div>
            </fieldset>

            <p class="ag-lead-step-error hidden" data-step-error>Elige un objetivo y tu nivel de partida para continuar.</p>
            <div class="ag-lead-actions">
              <button class="btn btn-primary ag-lead-next" type="button" data-next>Continuar a tus datos</button>
            </div>
          </div>

          <div class="ag-lead-step hidden" data-step="2" hidden>
            <div class="ag-lead-step-head">
              <p class="ag-lead-kicker">Paso 2 de 2</p>
              <p class="ag-lead-badge">Evaluación confidencial</p>
            </div>
            <h3 class="ag-lead-step-title">Tus datos</h3>
            <ol class="ag-lead-progress" aria-label="Progreso del formulario">
              <li class="is-done"><span>1</span> Objetivo</li>
              <li class="is-on"><span>2</span> Tus datos</li>
            </ol>

            {funded && (
              <select class="input" name="course">
                <option value="">Curso</option>
                <option>B2</option>
                <option>B2 ONLINE</option>
                <option>C1</option>
                <option>C1 ONLINE</option>
              </select>
            )}

            <label class="sr-only" for={`name-${source}`}>Nombre y Apellidos</label>
            <input class="input" id={`name-${source}`} name="name" required placeholder={funded ? 'Nombre' : 'Nombre y Apellidos'} />

            {funded ? (
              <>
                <label class="sr-only" for={`email-${source}`}>Dirección de correo electrónico</label>
                <input class="input" id={`email-${source}`} name="email" type="email" required placeholder="Dirección de correo electrónico" />
                <label class="sr-only" for={`phone-${source}`}>Teléfono Móvil</label>
                <input class="input" id={`phone-${source}`} name="phone" required placeholder="Teléfono Móvil" />
                <label class="sr-only" for={`dob-${source}`}>Fecha de Nacimiento DD/MM/AA</label>
                <input class="input" id={`dob-${source}`} name="dob" placeholder="Fecha de Nacimiento DD/MM/AA" />
                <input class="input" name="dni" placeholder="DNI" />
                <select class="input" name="occupation">
                  <option value="">Ocupación</option>
                  <option>Empleado</option>
                  <option>Desempleado</option>
                  <option>Trabajador de la Administración Pública</option>
                </select>
                <input class="input" name="company" placeholder="Empresa [SOLO EMPLEADOS]" />
                <input class="input" name="address" placeholder="Dirección" />
                <input class="input" name="postalCode" placeholder="Código Postal" />
                <input class="input" name="city" placeholder="Localidad" />
              </>
            ) : homeOrder ? (
              <>
                <label class="sr-only" for={`occupation-${source}`}>Ocupación</label>
                <input class="input" id={`occupation-${source}`} name="occupation" placeholder="Ocupación" />
                <label class="sr-only" for={`dob-${source}`}>Fecha de Nacimiento DD/MM/AA</label>
                <input class="input" id={`dob-${source}`} name="dob" placeholder="Fecha de Nacimiento DD/MM/AA" />
                <label class="sr-only" for={`email-${source}`}>Correo electrónico</label>
                <input class="input" id={`email-${source}`} name="email" type="email" required placeholder="Correo electrónico" />
                <label class="sr-only" for={`phone-${source}`}>Teléfono Movil</label>
                <input class="input" id={`phone-${source}`} name="phone" required placeholder="Teléfono Movil" />
              </>
            ) : (
              <>
                <label class="sr-only" for={`phone-${source}`}>Teléfono Movil</label>
                <input class="input" id={`phone-${source}`} name="phone" required placeholder="Teléfono Movil" />
                <label class="sr-only" for={`dob-${source}`}>Fecha de Nacimiento DD/MM/AA</label>
                <input class="input" id={`dob-${source}`} name="dob" placeholder="Fecha de Nacimiento DD/MM/AA" />
                <label class="sr-only" for={`email-${source}`}>Correo electrónico</label>
                <input class="input" id={`email-${source}`} name="email" type="email" required placeholder="Correo electrónico" />
                <label class="sr-only" for={`occupation-${source}`}>Ocupación</label>
                <input class="input" id={`occupation-${source}`} name="occupation" placeholder="Ocupación" />
              </>
            )}

            {extraFields.includes('discount') && (
              <input class="input" name="discount" placeholder="Código de descuento" />
            )}
            {!funded && extraFields.includes('dni') && <input class="input" name="dni" placeholder="DNI" />}
            {!funded && extraFields.includes('company') && (
              <input class="input" name="company" placeholder="Empresa [SOLO EMPLEADOS]" />
            )}
            {!funded && extraFields.includes('address') && (
              <>
                <input class="input" name="address" placeholder="Dirección" />
                <input class="input" name="postalCode" placeholder="Código Postal" />
                <input class="input" name="city" placeholder="Localidad" />
              </>
            )}
            {!funded && (
              <>
                <label class="sr-only" for={`message-${source}`}>Mensaje</label>
                <textarea class="input" id={`message-${source}`} name="message" placeholder="Mensaje" rows="5"></textarea>
              </>
            )}

            <div class="ag-lead-actions is-split">
              <button class="btn btn-muted ag-lead-back" type="button" data-back>Volver</button>
              <button class="btn btn-primary ag-lead-next" type="submit">{submitLabel}</button>
            </div>
            <p class="js-form-status hidden text-sm"></p>
          </div>
        </form>
      </div>

      <aside class="ag-lead-side">
        <div class="ag-lead-now">
          <p class="ag-lead-now-kicker">¿Prefieres resolverlo ahora?</p>
          <h3>Habla de inmediato con un coordinador académico</h3>
          <p>Sin esperas ni formularios. Te informamos al instante de grupos abiertos, plazas libres y precios cerrados.</p>
          <a class="btn btn-muted ag-lead-call" href={phoneHref}>Llamar al {phone}</a>
          <a class="btn btn-primary ag-lead-wa" href={whatsappHref} target="_blank" rel="noopener noreferrer">Chatear por WhatsApp en directo</a>
          <p class="ag-lead-now-note">Coordinación activa en Campus Pamplona</p>
        </div>
        <div class="ag-lead-why">
          <h3>¿Por qué miles eligen Georgetown?</h3>
          <ul>
            {reasons.map((reason) => (
              <li>
                <strong>{reason.title}</strong>
                <span>{reason.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .ag-lead {
    padding: 56px 0 72px;
    background: #fff;
    color: #000;
    font-family: "Open Sans", Arial, Helvetica, sans-serif;
  }

  .ag-lead-wrap {
    width: 80%;
    max-width: 1080px;
    margin-inline: auto;
  }

  .ag-lead-intro {
    margin-bottom: 28px;
    text-align: center;
  }

  .ag-lead-title {
    margin: 0 auto;
    max-width: 820px;
    color: #000;
    font-family: "Open Sans", Arial, Helvetica, sans-serif;
    font-size: 30px;
    font-weight: 300;
    line-height: 1.3;
    text-align: center;
  }

  .ag-lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.7fr);
    gap: 24px;
    align-items: start;
  }

  .ag-lead-form,
  .ag-lead-why,
  .ag-lead-now {
    padding: 32px 30px;
    border-radius: 0;
    background: #fff;
    box-shadow: 0 2px 18px 0 rgb(0 0 0 / 0.12);
  }

  .ag-lead-step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .ag-lead-kicker,
  .ag-lead-now-kicker,
  .ag-lead-badge {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #666;
  }

  .ag-lead-step-title {
    margin: 0 0 16px;
    font-family: "Open Sans", Arial, Helvetica, sans-serif;
    font-size: 26px;
    font-weight: 300;
    line-height: 1.2;
    color: #000;
  }

  .ag-lead-progress {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid #e6e6ea;
  }

  .ag-lead-progress li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 10px;
    color: #8a8a8a;
    font-size: 13px;
    font-weight: 400;
  }

  .ag-lead-progress li.is-on,
  .ag-lead-progress li.is-done {
    color: #0162a9;
    box-shadow: 0 1px 0 #0162a9;
  }

  .ag-lead-progress span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #f4f5f8;
    color: #666;
    font-size: 11px;
  }

  .ag-lead-progress .is-on span,
  .ag-lead-progress .is-done span {
    background: #0162a9;
    color: #fff;
  }

  .ag-lead-fieldset {
    margin: 0 0 20px;
    padding: 0;
    border: 0;
  }

  .ag-lead-fieldset legend {
    margin-bottom: 12px;
    color: #000;
    font-size: 16px;
    font-weight: 400;
  }

  .ag-lead-goals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .ag-lead-levels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .ag-lead-goal,
  .ag-lead-level {
    position: relative;
    cursor: pointer;
  }

  .ag-lead-goal {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16px;
    align-items: center;
    gap: 10px;
    min-height: 68px;
    padding: 12px 14px;
    border: 1px solid #e6e6ea;
    border-radius: 10px;
    background: #f6f7f8;
  }

  .ag-lead-level {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 8px 14px;
    border: 1px solid #e6e6ea;
    border-radius: 100px;
    background: #f6f7f8;
    text-align: center;
  }

  .ag-lead-goal input,
  .ag-lead-level input {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .ag-lead-goal:has(input:checked),
  .ag-lead-level:has(input:checked) {
    border-color: #0162a9;
    background: #eef5fb;
  }

  .ag-lead-goal-copy {
    min-width: 0;
  }

  .ag-lead-goal strong,
  .ag-lead-level strong {
    display: block;
    color: #000;
    font-style: normal;
    font-weight: 600;
  }

  .ag-lead-goal strong {
    font-size: 15px;
    line-height: 1.2;
  }

  .ag-lead-goal em,
  .ag-lead-level em {
    display: block;
    color: #666;
    font-style: normal;
  }

  .ag-lead-goal em {
    margin-top: 2px;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 400;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ag-lead-level strong {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
  }

  .ag-lead-radio {
    width: 16px;
    height: 16px;
    border: 1.5px solid #c5c5c5;
    border-radius: 50%;
    background: #fff;
  }

  .ag-lead-goal:has(input:checked) .ag-lead-radio {
    border-color: #0162a9;
    background: #0162a9;
    box-shadow: inset 0 0 0 3px #eef5fb;
  }

  .ag-lead-form .input {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: 0 0 21px;
    padding: 18px 20px;
    border: 0;
    border-radius: 10px;
    background: #f6f7f8;
    color: #555;
    font-family: "Open Sans", Arial, Helvetica, sans-serif;
    font-size: 15px;
    font-weight: 400;
  }

  .ag-lead-form .input::placeholder {
    color: #939393;
  }

  .ag-lead-form .input:focus {
    outline: none;
    background: #f0f1f3;
    color: #000;
  }

  .ag-lead-form textarea.input {
    min-height: 150px;
    resize: vertical;
  }

  .ag-lead-step-error {
    margin: 0 0 12px;
    color: #b42318;
    font-size: 14px;
  }

  .ag-lead-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .ag-lead-actions.is-split {
    justify-content: space-between;
  }

  .ag-lead-now h3,
  .ag-lead-why h3 {
    margin: 8px 0 12px;
    font-family: "Open Sans", Arial, Helvetica, sans-serif;
    font-size: 23px;
    font-weight: 300;
    line-height: 1.25;
    color: #000;
  }

  .ag-lead-now p {
    margin: 0 0 18px;
    color: #454545;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7;
  }

  .ag-lead-call,
  .ag-lead-wa {
    width: 100%;
    margin-bottom: 10px;
  }

  .ag-lead-now-note {
    margin: 8px 0 0;
    color: #666;
    font-size: 13px;
  }

  .ag-lead-why ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ag-lead-why li {
    margin: 0 0 16px;
    padding-left: 26px;
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='%23eef5fb'/><path fill='%230162a9' d='m10.2 15.6-3.3-3.3 1.4-1.4 1.9 1.9 5-5 1.4 1.4z'/></svg>") no-repeat left 2px / 18px;
  }

  .ag-lead-why strong,
  .ag-lead-why span {
    display: block;
  }

  .ag-lead-why strong {
    margin-bottom: 4px;
    font-size: 15px;
    font-weight: 600;
    color: #000;
  }

  .ag-lead-why span {
    color: #666;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
  }

  @media (max-width: 980px) {
    .ag-lead {
      padding: 40px 0 56px;
    }

    .ag-lead-title {
      max-width: none;
      font-size: 24px;
    }

    .ag-lead-grid,
    .ag-lead-goals {
      grid-template-columns: 1fr;
    }

    .ag-lead-levels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .ag-lead-step-title {
      font-size: 22px;
    }
  }
</style>

<script>
  import { initLeadForms } from '../scripts/forms';

  document.querySelectorAll<HTMLElement>('[data-wizard]').forEach((root) => {
    if (root.dataset.bound) return;
    root.dataset.bound = '1';
    const form = root.querySelector<HTMLFormElement>('form');
    const step1 = root.querySelector<HTMLElement>('[data-step="1"]');
    const step2 = root.querySelector<HTMLElement>('[data-step="2"]');
    const error = root.querySelector<HTMLElement>('[data-step-error]');

    const show = (step: '1' | '2') => {
      if (!step1 || !step2) return;
      const first = step === '1';
      step1.hidden = !first;
      step2.hidden = first;
      step1.classList.toggle('hidden', !first);
      step2.classList.toggle('hidden', first);
      root.querySelector<HTMLElement>(first ? '[data-step="1"]' : '[data-step="2"]')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    };

    root.querySelector('[data-next]')?.addEventListener('click', () => {
      const goal = form?.querySelector<HTMLInputElement>('input[name="englishGoal"]:checked');
      const level = form?.querySelector<HTMLInputElement>('input[name="startingLevel"]:checked');
      if (!goal || !level) {
        error?.classList.remove('hidden');
        return;
      }
      error?.classList.add('hidden');
      show('2');
    });

    root.querySelector('[data-back]')?.addEventListener('click', () => show('1'));
  });

  initLeadForms();
</script>
