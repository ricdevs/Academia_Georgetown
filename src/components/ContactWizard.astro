---
import { site } from '../data/site';

interface Props {
  source?: string;
  extraFields?: Array<'discount' | 'dni' | 'address' | 'company' | 'course'>;
  submitLabel?: string;
  fieldOrder?: 'default' | 'home';
  phone?: string;
  titleTag?: 'h1' | 'h2';
}

const {
  source = 'contacto',
  extraFields = [],
  submitLabel = 'Enviar',
  fieldOrder = 'default',
  phone = site.phone,
  titleTag = 'h2',
} = Astro.props;

const homeOrder = fieldOrder === 'home';
const funded = extraFields.includes('course');
const whatsappHref = `https://wa.me/34${site.phoneAlt.replace(/\s/g, '')}`;
const phoneHref = phone.replace(/\s/g, '').startsWith('+') ? `tel:${phone.replace(/\s/g, '')}` : `tel:+34${phone.replace(/\s/g, '')}`;

const goals = [
  {
    value: 'Cambridge',
    title: 'Cambridge',
    text: 'First, Advanced o Proficiency con centro examinador oficial.',
    icon: 'cert',
  },
  {
    value: 'Aptis',
    title: 'Aptis',
    text: 'Aptis General o Advanced by British Council.',
    icon: 'badge',
  },
  {
    value: 'TOEFL',
    title: 'TOEFL',
    text: 'TOEFL iBT® para universidad y movilidad internacional.',
    icon: 'globe',
  },
  {
    value: 'Empresa y Negociación',
    title: 'Empresa y Negociación',
    text: 'Fluidez ejecutiva, presentaciones e entrevistas.',
    icon: 'chart',
  },
  {
    value: 'Escolares',
    title: 'Escolares',
    text: 'ESO, Bachillerato y refuerzo para jóvenes.',
    icon: 'book',
  },
  {
    value: 'Otro',
    title: 'Otro',
    text: 'Cuéntanos tu objetivo y te preparamos un itinerario.',
    icon: 'other',
  },
];

const levels = [
  { value: 'A1-A2', title: 'A1 – A2', text: 'Básico / Nulo' },
  { value: 'B1-B2', title: 'B1 – B2', text: 'Intermedio fluido' },
  { value: 'C1-C2', title: 'C1 – C2', text: 'Avanzado / Nativo' },
  { value: 'Duda / Test', title: 'Duda / Test', text: 'Hacer test oral' },
];

const reasons = [
  {
    title: '98.4% de Aprobado en 1ª Convocatoria',
    text: 'Metodología auditada al 100% en el marco oficial Cambridge y Aptis.',
  },
  {
    title: 'Grupos Ultra-Reducidos',
    text: 'Máximo 8 alumnos por aula para garantizar 20-30 minutos de speaking por sesión.',
  },
  {
    title: 'Nativos Titulados y Examinadores',
    text: 'Docentes con certificación DELTA/CELTA y amplia experiencia en tribunales oficiales.',
  },
];
---

<section class="ag-lead" id="contacto" data-wizard>
  <div class="ag-lead-wrap">
    <header class="ag-lead-intro">
      {titleTag === 'h1' ? (
        <h1 class="ag-lead-title">Itinerario personalizado sin compromiso.</h1>
      ) : (
        <h2 class="ag-lead-title">Itinerario personalizado sin compromiso.</h2>
      )}
    </header>

    <div class="ag-lead-grid">
      <div class="ag-lead-main">
        <form class="ag-lead-form js-lead-form" data-source={source}>
          <input type="hidden" name="source" value={source} />
          <input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" />

          <div class="ag-lead-step" data-step="1">
            <div class="ag-lead-step-head">
              <p class="ag-lead-kicker">Paso 1 de 2</p>
              <p class="ag-lead-badge">Evaluación confidencial</p>
            </div>
            <h3 class="ag-lead-step-title">Define tu objetivo principal</h3>
            <ol class="ag-lead-progress" aria-label="Progreso del formulario">
              <li class="is-on"><span>1</span> Objetivo</li>
              <li><span>2</span> Tus datos</li>
            </ol>

            <fieldset class="ag-lead-fieldset">
              <legend>¿Para qué necesitas acreditar o perfeccionar tu inglés? *</legend>
              <div class="ag-lead-goals">
                {goals.map((goal) => (
                  <label class="ag-lead-goal">
                    <input type="radio" name="englishGoal" value={goal.value} required />
                    <span class="ag-lead-goal-icon" aria-hidden="true" data-icon={goal.icon}></span>
                    <span class="ag-lead-goal-copy">
                      <strong>{goal.title}</strong>
                      <em>{goal.text}</em>
                    </span>
                    <span class="ag-lead-radio" aria-hidden="true"></span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="ag-lead-fieldset">
              <legend>¿Cuál consideras que es tu nivel de partida aproximado? *</legend>
              <div class="ag-lead-levels">
                {levels.map((level) => (
                  <label class="ag-lead-level">
                    <input type="radio" name="startingLevel" value={level.value} required />
                    <strong>{level.title}</strong>
                    <em>{level.text}</em>
                  </label>
                ))}
              </div>
            </fieldset>

            <p class="ag-lead-step-error hidden" data-step-error>Elige un objetivo y tu nivel de partida para continuar.</p>
            <div class="ag-lead-actions">
              <button class="ag-lead-next" type="button" data-next>Continuar a tus datos</button>
            </div>
          </div>

          <div class="ag-lead-step hidden" data-step="2" hidden>
            <div class="ag-lead-step-head">
              <p class="ag-lead-kicker">Paso 2 de 2</p>
              <p class="ag-lead-badge">Evaluación confidencial</p>
            </div>
            <h3 class="ag-lead-step-title">Tus datos</h3>
            <ol class="ag-lead-progress" aria-label="Progreso del formulario">
              <li class="is-done"><span>1</span> Objetivo</li>
              <li class="is-on"><span>2</span> Tus datos</li>
            </ol>

            {funded && (
              <select class="input" name="course">
                <option value="">Curso</option>
                <option>B2</option>
                <option>B2 ONLINE</option>
                <option>C1</option>
                <option>C1 ONLINE</option>
              </select>
            )}

            <label class="sr-only" for={`name-${source}`}>Nombre y Apellidos</label>
            <input class="input" id={`name-${source}`} name="name" required placeholder={funded ? 'Nombre' : 'Nombre y Apellidos'} />

            {funded ? (
              <>
                <label class="sr-only" for={`email-${source}`}>Dirección de correo electrónico</label>
                <input class="input" id={`email-${source}`} name="email" type="email" required placeholder="Dirección de correo electrónico" />
                <label class="sr-only" for={`phone-${source}`}>Teléfono Móvil</label>
                <input class="input" id={`phone-${source}`} name="phone" required placeholder="Teléfono Móvil" />
                <label class="sr-only" for={`dob-${source}`}>Fecha de Nacimiento DD/MM/AA</label>
                <input class="input" id={`dob-${source}`} name="dob" placeholder="Fecha de Nacimiento DD/MM/AA" />
                <input class="input" name="dni" placeholder="DNI" />
                <select class="input" name="occupation">
                  <option value="">Ocupación</option>
                  <option>Empleado</option>
                  <option>Desempleado</option>
                  <option>Trabajador de la Administración Pública</option>
                </select>
                <input class="input" name="company" placeholder="Empresa [SOLO EMPLEADOS]" />
                <input class="input" name="address" placeholder="Dirección" />
                <input class="input" name="postalCode" placeholder="Código Postal" />
                <input class="input" name="city" placeholder="Localidad" />
              </>
            ) : homeOrder ? (
              <>
                <label class="sr-only" for={`occupation-${source}`}>Ocupación</label>
                <input class="input" id={`occupation-${source}`} name="occupation" placeholder="Ocupación" />
                <label class="sr-only" for={`dob-${source}`}>Fecha de Nacimiento DD/MM/AA</label>
                <input class="input" id={`dob-${source}`} name="dob" placeholder="Fecha de Nacimiento DD/MM/AA" />
                <label class="sr-only" for={`email-${source}`}>Correo electrónico</label>
                <input class="input" id={`email-${source}`} name="email" type="email" required placeholder="Correo electrónico" />
                <label class="sr-only" for={`phone-${source}`}>Teléfono Movil</label>
                <input class="input" id={`phone-${source}`} name="phone" required placeholder="Teléfono Movil" />
              </>
            ) : (
              <>
                <label class="sr-only" for={`phone-${source}`}>Teléfono Movil</label>
                <input class="input" id={`phone-${source}`} name="phone" required placeholder="Teléfono Movil" />
                <label class="sr-only" for={`dob-${source}`}>Fecha de Nacimiento DD/MM/AA</label>
                <input class="input" id={`dob-${source}`} name="dob" placeholder="Fecha de Nacimiento DD/MM/AA" />
                <label class="sr-only" for={`email-${source}`}>Correo electrónico</label>
                <input class="input" id={`email-${source}`} name="email" type="email" required placeholder="Correo electrónico" />
                <label class="sr-only" for={`occupation-${source}`}>Ocupación</label>
                <input class="input" id={`occupation-${source}`} name="occupation" placeholder="Ocupación" />
              </>
            )}

            {extraFields.includes('discount') && (
              <input class="input" name="discount" placeholder="Código de descuento" />
            )}
            {!funded && extraFields.includes('dni') && <input class="input" name="dni" placeholder="DNI" />}
            {!funded && extraFields.includes('company') && (
              <input class="input" name="company" placeholder="Empresa [SOLO EMPLEADOS]" />
            )}
            {!funded && extraFields.includes('address') && (
              <>
                <input class="input" name="address" placeholder="Dirección" />
                <input class="input" name="postalCode" placeholder="Código Postal" />
                <input class="input" name="city" placeholder="Localidad" />
              </>
            )}
            {!funded && (
              <>
                <label class="sr-only" for={`message-${source}`}>Mensaje</label>
                <textarea class="input" id={`message-${source}`} name="message" placeholder="Mensaje" rows="5"></textarea>
              </>
            )}

            <div class="ag-lead-actions is-split">
              <button class="ag-lead-back" type="button" data-back>Volver</button>
              <button class="ag-lead-next" type="submit">{submitLabel}</button>
            </div>
            <p class="js-form-status hidden text-sm"></p>
          </div>
        </form>
      </div>

      <aside class="ag-lead-side">
        <div class="ag-lead-now">
          <p class="ag-lead-now-kicker">¿Prefieres resolverlo ahora?</p>
          <h3>Habla de inmediato con un coordinador académico</h3>
          <p>Sin esperas ni formularios. Te informamos al instante de grupos abiertos, plazas libres y precios cerrados.</p>
          <a class="ag-lead-call" href={phoneHref}>Llamar al {phone}</a>
          <a class="ag-lead-wa" href={whatsappHref} target="_blank" rel="noopener noreferrer">Chatear por WhatsApp en directo</a>
          <p class="ag-lead-now-note">Coordinación activa en Campus Pamplona</p>
        </div>
        <div class="ag-lead-why">
          <h3>¿Por qué miles eligen Georgetown?</h3>
          <ul>
            {reasons.map((reason) => (
              <li>
                <strong>{reason.title}</strong>
                <span>{reason.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .ag-lead {
    padding: 72px 0 96px;
    background: #f6f7fb;
    color: #0b1028;
  }

  .ag-lead-wrap {
    width: min(1180px, 92%);
    margin-inline: auto;
  }

  .ag-lead-intro {
    margin-bottom: 36px;
  }

  .ag-lead-title {
    margin: 0;
    max-width: 16ch;
    color: #0b1028;
    font-family: "Poppins", Helvetica, Arial, sans-serif;
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 700;
    line-height: 1.12;
  }

  .ag-lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.7fr);
    gap: 28px;
    align-items: start;
  }

  .ag-lead-form,
  .ag-lead-why {
    padding: 28px 28px 32px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 18px 50px -28px rgb(11 16 40 / 0.28);
  }

  .ag-lead-step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .ag-lead-kicker,
  .ag-lead-now-kicker,
  .ag-lead-badge {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ag-lead-kicker,
  .ag-lead-now-kicker {
    color: #6b7288;
  }

  .ag-lead-badge {
    color: #0b1028;
  }

  .ag-lead-step-title {
    margin: 0 0 18px;
    font-family: "Poppins", Helvetica, Arial, sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
  }

  .ag-lead-progress {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    border-bottom: 2px solid #edf0f5;
  }

  .ag-lead-progress li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 12px;
    color: #8b93a7;
    font-size: 13px;
    font-weight: 600;
  }

  .ag-lead-progress li.is-on,
  .ag-lead-progress li.is-done {
    color: #0b1028;
    box-shadow: 0 2px 0 #f5b400;
  }

  .ag-lead-progress span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #edf0f5;
    font-size: 11px;
  }

  .ag-lead-progress .is-on span,
  .ag-lead-progress .is-done span {
    background: #f5b400;
    color: #0b1028;
  }

  .ag-lead-fieldset {
    margin: 0 0 20px;
    padding: 0;
    border: 0;
  }

  .ag-lead-fieldset legend {
    margin-bottom: 14px;
    color: #0b1028;
    font-size: 16px;
    font-weight: 600;
  }

  .ag-lead-goals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .ag-lead-levels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .ag-lead-goal,
  .ag-lead-level {
    position: relative;
    cursor: pointer;
  }

  .ag-lead-goal {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 10px;
    min-height: 72px;
    padding: 12px 14px;
    border: 1px solid #eceff4;
    border-radius: 12px;
    background: #fff;
  }

  .ag-lead-level {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 8px 6px;
    border: 1px solid transparent;
    border-radius: 14px;
    background: #f7f8fb;
    text-align: center;
  }

  .ag-lead-goal input,
  .ag-lead-level input {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .ag-lead-goal:has(input:checked),
  .ag-lead-level:has(input:checked) {
    border-color: #0b1028;
    background: #fff8e6;
  }

  .ag-lead-goal-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #0b1028;
  }

  .ag-lead-goal-icon::before {
    content: "";
    width: 16px;
    height: 16px;
    background: #fff;
    -webkit-mask: no-repeat center / contain;
    mask: no-repeat center / contain;
  }

  .ag-lead-goal-icon[data-icon='cert']::before {
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11zm-6.5-5.5 1.5 3 1.5-3 3-.5-2.2-2.1.7-3.4-2.5 1.5-2.5-1.5.7 3.4L8 14.5l3.5.5z'/></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11zm-6.5-5.5 1.5 3 1.5-3 3-.5-2.2-2.1.7-3.4-2.5 1.5-2.5-1.5.7 3.4L8 14.5l3.5.5z'/></svg>");
  }

  .ag-lead-goal-icon[data-icon='badge']::before {
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 2 8.5 8.5 2 9.3l5 4.9L5.8 21 12 17.8 18.2 21 17 14.2l5-4.9-6.5-.8L12 2zm0 4.2 1.6 3.2 3.5.4-2.6 2.5.7 3.5L12 14.4 8.8 16l.7-3.5-2.6-2.5 3.5-.4L12 6.2z'/></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 2 8.5 8.5 2 9.3l5 4.9L5.8 21 12 17.8 18.2 21 17 14.2l5-4.9-6.5-.8L12 2zm0 4.2 1.6 3.2 3.5.4-2.6 2.5.7 3.5L12 14.4 8.8 16l.7-3.5-2.6-2.5 3.5-.4L12 6.2z'/></svg>");
  }

  .ag-lead-goal-icon[data-icon='globe']::before {
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-3.2a15.7 15.7 0 0 0-1.4-3.8A8 8 0 0 1 18.9 8zM12 4c.7 1.1 1.6 2.7 2.1 4H9.9C10.4 6.7 11.3 5.1 12 4zM4.3 14a8 8 0 0 1 0-4h3.7a16 16 0 0 0 0 4H4.3zM8.9 16h3.2c-.5 1.3-1.4 2.9-2.1 4A8 8 0 0 1 5.1 16h3.8zm1.1 0h4c.5 1.3 1.4 2.9 2.1 4A8 8 0 0 1 8.9 16zm5.1 0h3.8a8 8 0 0 1-4.9 4c.7-1.1 1.6-2.7 2.1-4zM16 14h3.7a8 8 0 0 0 0-4H16a16 16 0 0 1 0 4zm-1.1-6h-5.8a16 16 0 0 0 0 4h5.8a16 16 0 0 0 0-4z'/></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-3.2a15.7 15.7 0 0 0-1.4-3.8A8 8 0 0 1 18.9 8zM12 4c.7 1.1 1.6 2.7 2.1 4H9.9C10.4 6.7 11.3 5.1 12 4zM4.3 14a8 8 0 0 1 0-4h3.7a16 16 0 0 0 0 4H4.3zM8.9 16h3.2c-.5 1.3-1.4 2.9-2.1 4A8 8 0 0 1 5.1 16h3.8zm1.1 0h4c.5 1.3 1.4 2.9 2.1 4A8 8 0 0 1 8.9 16zm5.1 0h3.8a8 8 0 0 1-4.9 4c.7-1.1 1.6-2.7 2.1-4zM16 14h3.7a8 8 0 0 0 0-4H16a16 16 0 0 1 0 4zm-1.1-6h-5.8a16 16 0 0 0 0 4h5.8a16 16 0 0 0 0-4z'/></svg>");
  }

  .ag-lead-goal-icon[data-icon='chart']::before {
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M3 3h2v16h16v2H3V3zm14 6 4 4-1.4 1.4-2.6-2.58V17h-2v-5.18l-2.6 2.58L11 13l6-6z'/></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M3 3h2v16h16v2H3V3zm14 6 4 4-1.4 1.4-2.6-2.58V17h-2v-5.18l-2.6 2.58L11 13l6-6z'/></svg>");
  }

  .ag-lead-goal-icon[data-icon='book']::before {
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M18 2H8a3 3 0 0 0-3 3v14a3 3 0 0 0 3 3h12V4a2 2 0 0 0-2-2zm0 18H8a1 1 0 0 1 0-2h10v2zM8 4h10v12H8a3 3 0 0 0-1 .17V5a1 1 0 0 1 1-1z'/></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M18 2H8a3 3 0 0 0-3 3v14a3 3 0 0 0 3 3h12V4a2 2 0 0 0-2-2zm0 18H8a1 1 0 0 1 0-2h10v2zM8 4h10v12H8a3 3 0 0 0-1 .17V5a1 1 0 0 1 1-1z'/></svg>");
  }

  .ag-lead-goal-icon[data-icon='other']::before {
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 2a10 10 0 1 0 .01 20.01A10 10 0 0 0 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z'/></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 2a10 10 0 1 0 .01 20.01A10 10 0 0 0 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z'/></svg>");
  }

  .ag-lead-goal-copy {
    min-width: 0;
  }

  .ag-lead-goal strong,
  .ag-lead-level strong {
    display: block;
    color: #0b1028;
    font-style: normal;
    font-weight: 700;
  }

  .ag-lead-goal strong {
    font-size: 14px;
    line-height: 1.2;
  }

  .ag-lead-goal em,
  .ag-lead-level em {
