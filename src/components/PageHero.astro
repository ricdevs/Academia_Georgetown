---
import { withBase } from '../lib/url';

interface Props {
  kicker?: string;
  title: string;
  lede?: string;
  actions?: { href: string; label: string }[];
}

const {
  kicker = 'Academia de inglés en Pamplona y online',
  title,
  lede,
  actions = [
    { href: '/contacto/', label: 'Solicitar Información' },
    { href: '/prueba-de-nivel/', label: 'Realiza una prueba de nivel' },
  ],
} = Astro.props;
---

<section class="ag-page-hero">
  <div class="container-ag">
    {kicker && <p class="ag-kicker">{kicker}</p>}
    <h1 data-reveal="left">{title}</h1>
    {lede && <p class="ag-lede">{lede}</p>}
    {actions.length > 0 && (
      <div class="ag-hero-actions">
        {actions.map((a, i) => (
          <a class:list={['btn', i === 0 ? 'btn-primary' : 'btn-muted']} href={withBase(a.href)}>
            {a.label}
          </a>
        ))}
      </div>
    )}
  </div>
</section>
